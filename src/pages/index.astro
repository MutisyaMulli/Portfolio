---
import "../styles/global.css";
import Section from "../components/Section.astro";
import DiffPanels from "../components/DiffPanels.astro";
import SourcingDiagram from "../components/SourcingDiagram.astro";
import DefenseLayers from "../components/DefenseLayers.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const navItems = [
  { id: "overview", label: "Overview" },
  { id: "principles", label: "Principles" },
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
  { id: "samples", label: "Samples" },
  { id: "capabilities", label: "Capabilities" },
  { id: "track-record", label: "Track record" },
  { id: "education", label: "Education" },
  { id: "contact", label: "Contact" },
];

const samples = [
  {
    company: "Chameleon Software — Case Manager",
    url: "https://learning.casemanager.biz/",
    caption:
      "The Case Manager Learning Site: version release notes, video walkthroughs, and structured help articles with breadcrumbs, cross-references, and inline screenshots.",
    images: [
      { src: "images/casemanager-home.png", alt: "Case Manager Learning Site homepage, showing release history and getting-started links" },
      { src: "images/casemanager-docs.png", alt: "A Case Manager help article on security groups and permissions, with sidebar navigation and an embedded walkthrough video" },
    ],
  },
];

const diffExamples = [
  {
    before:
      "retry logic kicks in after token expiry, 3x, then just fails silently. logs have the detail if anyone wants to dig in",
    after:
      "If your session expires, the system retries the request up to three times, then shows an error explaining how to sign in again.",
  },
  {
    before:
      "job doesnt complete if operator skips step 4, no error just hangs on the UI, happened 3x this week per support",
    after:
      "Steps must be completed in order. Skipping step 4 stops the job without an error message. Contact support if a job stops responding.",
  },
  {
    before:
      "dont let them submit without the consent checkbox ticked, legal needs it logged w/ timestamp, ping compliance if unsure",
    after:
      "The form can't be submitted until the consent checkbox is selected. Submissions are logged with a timestamp to meet compliance requirements.",
  },
];

const experience = [
  {
    company: "Advantive",
    role: "Technical Writing Lead",
    date: "Feb 2023 — Present",
    summary:
      "Leading documentation for ERP and manufacturing execution platforms, embedded into the SDLC.",
    bullets: [
      "Design structured authoring workflows in MadCap Flare — metadata, conditional text, single-sourcing across multiple outputs",
      "Partner with Product, Engineering, QA, and Support to align docs with product decisions",
      "Integrate AI-assisted review and indexing into the documentation workflow",
    ],
  },
  {
    company: "Mondial Software, Inc.",
    role: "Technical Writer / Quality Assurance",
    date: "Feb 2021 — Oct 2022",
    summary:
      "Built usability-driven help centers and structured content systems for enterprise software.",
    bullets: [
      "Supported QA through feature testing alongside documentation work",
      "Applied information architecture and API documentation to improve clarity",
    ],
  },
  {
    company: "Chameleon Software Australia",
    role: "Contract Technical Writer",
    date: null,
    summary:
      "Documented medical software for clinical workflows, with an emphasis on compliance and precision.",
    bullets: [
      "Produced API documentation and UX/UI content for clinical workflows",
      "Applied structured authoring and single-sourcing across a regulated environment",
    ],
  },
  {
    company: "AFS Software (United States)",
    role: "Contract Technical Writer",
    date: null,
    summary:
      "Documented medical ERP and SaaS platforms to meet healthcare compliance and clarity standards.",
    bullets: [
      "Designed content systems that cut maintenance overhead and improved discoverability",
    ],
  },
];

const capabilities = [
  {
    heading: "How I work",
    items: [
      "Structured authoring & single-sourcing",
      "Metadata & conditional-text patterns",
      "Information architecture",
      "SDLC integration",
      "Agile & Scrum",
      "CI/CD documentation",
    ],
  },
  {
    heading: "Infrastructure & automation",
    items: [
      "Automated publishing pipelines",
      "Custom Git/CLI tooling",
      "Style-guide & rebrand migrations",
      "Legacy content cleanup & consolidation",
      "AI-assisted documentation review & indexing",
    ],
  },
  {
    heading: "Tools",
    items: [
      "MadCap Flare",
      "MkDocs Material",
      "Confluence",
      "Git & GitHub",
      "GitHub Actions",
      "Swagger",
    ],
    moreItems: [
      "GitBook",
      "Azure DevOps",
      "Markdown",
      "PowerShell",
      "Zendesk",
      "Salesforce",
      "SharePoint",
    ],
  },
];

const principles = [
  {
    term: "Automate the boring parts",
    body: "If I'm fixing the same problem twice, I write a script instead of doing it by hand a third time.",
  },
  {
    term: "Boring tools win",
    body: "Given the choice, I pick the tool a five-person team can actually maintain over the one with the longer feature list. Plain Markdown and YAML beat a React-based docs stack when most of the team isn't writing code.",
  },
  {
    term: "Precision over polish",
    body: "In regulated software — clinical workflows, financial platforms — a confusing sentence is a compliance problem, not a style nitpick. I'd rather ship something plain and exact than something polished and ambiguous.",
  },
];

const projects = [
  {
    heading: "ADO HTML Commit Previewer",
    tags: ["Browser extension", "Security", "Chrome · Firefox · Edge"],
    summary:
      "A browser extension that fixes Azure DevOps' broken HTML preview for commits and PRs — real CSS, real images, and layered defenses against the fact that every previewed file is untrusted input.",
    paragraphs: [
      "Azure DevOps' built-in preview for HTML files changed in a commit or PR has no CSS and never resolves repo-relative image paths, so reviewing exported documentation before merge was effectively impossible. I built an extension that detects commit and PR pages, lists every changed HTML file, and renders each one with real images and consistent styling.",
      "The harder problem was authentication without a token: the extension proxies API calls through a content script running in the user's own Azure DevOps tab, so requests carry real session cookies, sidestepping the SameSite restrictions that block a direct cross-origin fetch from the extension's service worker.",
      "Every previewed page is attacker-controlled input, so rendering goes through layered defenses: script and style stripping, a strict injected CSP, external-resource blocking so a file can't beacon out to detect it was previewed, and a sandboxed iframe with no script execution as the final backstop against any sanitizer gap, including a known mutation-XSS risk from re-serializing parsed HTML.",
      "One manifest.json runs on Chrome, Edge, and Firefox, handling the real differences between Chrome's service-worker background model and Firefox's background-scripts model, verified against Mozilla's own web-ext linter. 45 unit tests, using Node's built-in test runner and jsdom, cover the security-critical sanitization logic directly.",
    ],
    defenseDiagram: true,
  },
  {
    heading: "Flare → docs-as-code migration",
    tags: ["Information architecture", "MkDocs Material", "CI/CD"],
    summary:
      "Leading a migration of a 591-topic MadCap Flare help system to a docs-as-code setup on MkDocs Material, across five output targets including a Word deliverable.",
    paragraphs: [
      "At Advantive, I'm leading a migration of a legacy MadCap Flare help system — 591 topics across five output targets, including HTML5 WebHelp and a Word-format client deliverable — to a docs-as-code setup built on MkDocs Material with GitHub Actions for CI/CD.",
      "I evaluated MkDocs Material against Docusaurus and picked it because it keeps the authoring experience simple for a mixed team of technical and non-technical writers: plain Markdown and YAML config, no React or Node.js to maintain.",
      "The Word output was the hard part. Docs-as-code tools don't export to Word natively, so I built a small Pandoc-based pipeline to cover it. Estimated at 6–10 weeks focused, or 3–4 months alongside regular release work.",
    ],
    sourcingDiagram: true,
  },
  {
    heading: "Asset intake & tracking system",
    tags: ["Google Apps Script", "Google Sheets", "No-code"],
    summary:
      "A browser-based asset tracking system for equipment checkout and maintenance, built entirely on Google Workspace — no separate backend or hosting.",
    paragraphs: [
      "Built an asset tracking system for equipment checkout, maintenance, and consumables, running entirely in the browser: Google Forms for intake, Apps Script for the backend, a custom web app for checkout/return and maintenance.",
      "Google Sheets is the system of record — FILTER, INDEX/MATCH, SUMPRODUCT instead of a separate database — with Drive storing per-asset photo folders and an optional Looker Studio dashboard for admins.",
      "The web app pages are plain HTML, CSS, and JavaScript, calling the backend through google.script.run, hosted on a Google Sites page with access limited to specific users and groups. No code editor, no separate hosting — which is most of why a small team can keep it running.",
    ],
  },
];

const trackRecord = [
  ["Job success", "100%"],
  ["Rating", "5.0 (10 reviews)"],
  ["Status", "Top Rated Plus"],
  ["Projects completed", "15"],
  ["Hours logged", "7,600+"],
];

const education = [
  { title: "Bachelor of Arts", source: "Kisii University", year: null },
  { title: "Software Engineering", source: "Moringa School", year: "2025" },
];

const certifications = [
  { title: "Foundations of Cybersecurity", source: "Google", year: "2025" },
  { title: "Play It Safe: Manage Security Risks", source: "Google", year: "2025" },
  {
    title: "Financial Analysis & Accounting (7 courses)",
    source: "Corporate Finance Institute",
    year: "2022",
  },
  { title: "Fundamentals of Digital Marketing", source: "Google", year: "2021" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Anthony Mutisya — Documentation Engineer. Documentation and documentation systems for ERP, manufacturing execution, and SaaS platforms."
    />
    <title>Anthony Mutisya — Documentation Engineer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="progress-bar" id="progress-bar"></div>

    <div class="page">
      <nav class="toc" aria-label="Section navigation">
        {navItems.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
      </nav>

      <main class="wrap">
      <section class="doc-section hero">
        <div class="content">
          <h1 class="gradient-text">Anthony Mutisya</h1>
          <p class="role">Documentation Engineer</p>
          <p class="role-sub">Technical Writing Lead at Advantive</p>
          <p class="tagline">
            Most engineering notes aren't wrong, just unreadable by the
            people who need them. I turn them into documentation that is.
          </p>
          <DiffPanels examples={diffExamples} />
          <p class="hero-links">
            <a href="#contact">Get in touch</a> <a href="#experience">See my experience</a>
          </p>
        </div>
      </section>

      <Section id="overview">
        <h2>Overview</h2>
        <p>
          Six years, four industries: ERP, manufacturing execution,
          enterprise sales, and medical software. The product changes every
          time — what doesn't is the gap between what engineering built and
          what a user needs to understand to use it. Closing that gap is the
          job, whether it's a forty-page user guide, one error message, or
          rebuilding the systems that produce the documentation in the first
          place.
        </p>
        <p>
          I also have a QA background. Bad documentation usually isn't badly
          written — it's just wrong, because nobody checked it against what
          the product actually does. I check.
        </p>
      </Section>

      <Section id="principles">
        <h2>Principles</h2>
        <ul class="principle-list">
          {
            principles.map((p, i) => (
              <li class="principle">
                <span class="principle-index">{String(i + 1).padStart(2, "0")}</span>
                <h3>{p.term}</h3>
                <p>{p.body}</p>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="experience">
        <h2>Experience</h2>
        <ul class="experience-list">
          {
            experience.map((job) => (
              <li class="job">
                <div class="job-head">
                  <h3>{job.company}</h3>
                  {job.date && <span class="job-date">{job.date}</span>}
                </div>
                <p class="job-role">{job.role}</p>
                <p class="job-summary">{job.summary}</p>
                <details class="disclosure">
                  <summary>Details</summary>
                  <ul class="job-bullets">
                    {job.bullets.map((point) => <li>{point}</li>)}
                  </ul>
                </details>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="projects">
        <h2>Projects</h2>
        <ul class="project-list">
          {
            projects.map((project) => (
              <li class="project">
                <h3>{project.heading}</h3>
                <ul class="chip-list">
                  {project.tags.map((tag) => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
                <p>{project.summary}</p>
                <details class="disclosure">
                  <summary>Read more</summary>
                  {project.paragraphs.map((para) => <p>{para}</p>)}
                  {project.sourcingDiagram && <SourcingDiagram />}
                  {project.defenseDiagram && <DefenseLayers />}
                </details>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="samples">
        <h2>Documentation samples</h2>
        <ul class="sample-list">
          {
            samples.map((sample) => (
              <li class="sample">
                <h3>{sample.company}</h3>
                <div class="sample-images">
                  {sample.images.map((img) => (
                    <img src={`${base}${img.src}`} alt={img.alt} loading="lazy" />
                  ))}
                </div>
                <p>{sample.caption}</p>
                <a href={sample.url} target="_blank" rel="noopener noreferrer" class="sample-link">
                  {sample.url.replace("https://", "")}
                </a>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="capabilities">
        <h2>Capabilities</h2>
        <div class="capability-groups">
          {
            capabilities.map((group) => (
              <div class="capability-group">
                <h3>{group.heading}</h3>
                <ul class="capability-list">
                  {group.items.map((item) => (
                    <li class="capability-chip">{item}</li>
                  ))}
                </ul>
                {group.moreItems && (
                  <details class="disclosure">
                    <summary>Show {group.moreItems.length} more</summary>
                    <ul class="capability-list">
                      {group.moreItems.map((item) => (
                        <li class="capability-chip">{item}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            ))
          }
        </div>
      </Section>

      <Section id="track-record">
        <h2>Track record</h2>
        <p>
          Alongside full-time and contract roles, I've completed 15 projects
          as a freelance technical writer on Upwork:
        </p>
        <dl class="stats">
          {
            trackRecord.map(([label, value]) => (
              <div class="stat">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <Section id="education">
        <h2>Education &amp; certifications</h2>
        <div class="credential-groups">
          <div class="credential-group">
            <h3>Education</h3>
            <ul class="credential-list">
              {
                education.map((item) => (
                  <li class="credential-chip">
                    <span class="credential-title">{item.title}</span>
                    <span class="credential-meta">
                      {item.source}
                      {item.year && ` · ${item.year}`}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="credential-group">
            <h3>Certifications</h3>
            <ul class="credential-list">
              {
                certifications.map((item) => (
                  <li class="credential-chip">
                    <span class="credential-title">{item.title}</span>
                    <span class="credential-meta">
                      {item.source}
                      {item.year && ` · ${item.year}`}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </Section>

      <Section id="contact">
        <h2>Get in touch</h2>
        <p>
          Open to new freelance projects and full-time roles — reach out.
        </p>
        <ul class="contact-list">
          <li>
            <a href="mailto:mutisyamullie@gmail.com">mutisyamullie@gmail.com</a>
          </li>
          <li>
            <a href="tel:+254790266965">+254 790 266 965</a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/anthony-mutisya-mulli"
              target="_blank"
              rel="noopener noreferrer">LinkedIn</a
            >
          </li>
          <li>
            <a
              href="https://www.upwork.com/freelancers/~0154c0ae43f5bb0310"
              target="_blank"
              rel="noopener noreferrer">Upwork</a
            >
          </li>
          <li class="muted">Nairobi, Kenya</li>
        </ul>
      </Section>
      </main>
    </div>

    <style>
      .gradient-text {
        background: var(--gradient);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        color: var(--accent);
      }

      .hero h1 {
        font-size: clamp(2.25rem, 6vw, 3.25rem);
      }

      .hero .role {
        font-family: var(--font-mono);
        color: var(--accent-2);
        font-size: 1rem;
        margin: 14px 0 0;
      }

      .hero .role-sub {
        font-family: var(--font-mono);
        color: var(--text-muted);
        font-size: 0.8125rem;
        margin: 4px 0 0;
      }

      .hero .tagline {
        font-size: 1.1875rem;
        max-width: 38ch;
        margin: 22px 0 0;
      }

      .hero-links {
        margin-top: 36px;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        display: flex;
        gap: 20px;
      }

      .principle-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .principle {
        background: var(--bg-panel);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 24px;
      }

      .principle-index {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent-2);
        margin-bottom: 10px;
      }

      .principle h3 {
        font-size: 0.9375rem;
        margin-bottom: 8px;
      }

      .experience-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .job {
        background: var(--bg-panel);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 24px;
      }

      .job-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .job-date {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        white-space: nowrap;
      }

      .job-role {
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        margin: 4px 0 12px;
      }

      .job-summary {
        color: var(--text-muted);
        margin-bottom: 0;
      }

      .disclosure {
        margin-top: 14px;
      }

      .disclosure summary {
        cursor: pointer;
        list-style: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent-2);
        -webkit-user-select: none;
        user-select: none;
      }

      .disclosure summary::-webkit-details-marker {
        display: none;
      }

      .disclosure summary::before {
        content: "+";
        display: inline-block;
        width: 1em;
        text-align: center;
      }

      .disclosure[open] summary::before {
        content: "−";
      }

      .disclosure summary:hover {
        color: var(--accent);
      }

      .disclosure[open] summary {
        margin-bottom: 12px;
      }

      .job-bullets {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .job-bullets li {
        font-size: 0.9375rem;
        padding-left: 18px;
        position: relative;
      }

      .job-bullets li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.65em;
        width: 6px;
        height: 1px;
        background: var(--accent);
      }

      .project-list {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .project {
        background: var(--bg-panel);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 28px;
      }

      .project h3 {
        font-size: 1.0625rem;
        margin-bottom: 14px;
      }

      .project p {
        margin-bottom: 1em;
      }

      .chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 18px;
      }

      .chip {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 4px 12px;
        white-space: nowrap;
      }

      @media (max-width: 600px) {
        .project,
        .job {
          padding: 20px;
        }
      }

      .sample-list {
        display: flex;
        flex-direction: column;
        gap: 48px;
      }

      .sample h3 {
        font-size: 1.0625rem;
        margin-bottom: 14px;
      }

      .sample-images {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .sample-images img {
        width: 100%;
        display: block;
        border: 1px solid var(--rule);
        border-radius: 4px;
      }

      .sample p {
        margin-top: 16px;
        color: var(--text-muted);
        font-size: 0.9375rem;
      }

      .sample-link {
        display: inline-block;
        margin-top: 8px;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
      }

      @media (max-width: 600px) {
        .sample-images {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      .capability-groups {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      .capability-group h3 {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        margin-bottom: 14px;
      }

      .capability-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .capability-chip {
        font-size: 0.875rem;
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 8px 16px;
        background: var(--bg-panel);
        transition: border-color 0.15s ease;
      }

      .capability-chip:hover {
        border-color: var(--accent);
      }

      .stats {
        margin: 28px 0 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 32px;
      }

      .stat {
        border-top: 1px solid var(--rule);
        padding-top: 10px;
      }

      .stat dt {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      .stat dd {
        margin: 4px 0 0;
        font-size: 1.125rem;
      }

      .credential-groups {
        margin-top: 4px;
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      .credential-group h3 {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        margin-bottom: 14px;
      }

      .credential-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .credential-chip {
        display: flex;
        flex-direction: column;
        gap: 3px;
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 10px 14px;
        background: var(--bg-panel);
        transition: border-color 0.15s ease;
      }

      .credential-chip:hover {
        border-color: var(--accent);
      }

      .credential-title {
        font-size: 0.875rem;
      }

      .credential-meta {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--text-muted);
      }

      .contact-list {
        margin-top: 24px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 0.9375rem;
      }

      .contact-list .muted {
        color: var(--text-muted);
      }

      @media (max-width: 760px) {
        .stats {
          grid-template-columns: minmax(0, 1fr);
        }
      }
    </style>

    <script>
      const links = document.querySelectorAll<HTMLAnchorElement>(".toc a");
      const map = new Map<string, HTMLAnchorElement>();
      links.forEach((a) => map.set(a.getAttribute("href")!.slice(1), a));

      const sections = document.querySelectorAll<HTMLElement>(".doc-section[id]");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const link = map.get(entry.target.id);
            if (!link || !entry.isIntersecting) return;
            links.forEach((a) => a.classList.remove("active"));
            link.classList.add("active");
          });
        },
        { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
      );

      sections.forEach((section) => observer.observe(section));

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      sections.forEach((section) => revealObserver.observe(section));

      const progressBar = document.getElementById("progress-bar");
      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
        if (progressBar) progressBar.style.width = `${Math.min(ratio, 1) * 100}%`;
      };
      updateProgress();
      window.addEventListener("scroll", updateProgress, { passive: true });
      window.addEventListener("resize", updateProgress);
    </script>
  </body>
</html>
