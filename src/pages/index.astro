      .capability-groups {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 32px 48px;
      }

      .capability-group h3 {
        font-size: 0.8125rem;
        color: var(--text-muted);
        margin-bottom: 14px;
      }

