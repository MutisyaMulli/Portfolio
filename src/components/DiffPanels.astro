---
interface Example {
  before: string;
  after: string;
}

interface Props {
  examples: Example[];
}

const { examples } = Astro.props;
const first = examples[0];
---

<div class="diff-wrap" data-examples={JSON.stringify(examples)}>
  <div class="diff">
    <div class="panel panel--before">
      <span class="panel-label">Engineering note</span>
      <p class="panel-text panel-text--mono" data-field="before">{first.before}</p>
    </div>
    <div class="connector" aria-hidden="true">becomes</div>
    <div class="panel panel--after">
      <span class="panel-label">Shipped documentation</span>
      <p class="panel-text" data-field="after">{first.after}</p>
    </div>
  </div>
  {
    examples.length > 1 && (
      <button class="diff-cycle" type="button">
        Try another example
      </button>
    )
  }
</div>

<style>
  .diff {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
  }

  .panel {
    background: var(--bg-panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 20px 22px;
    opacity: 0;
    transform: translateY(6px);
    animation: reveal 0.5s ease-out forwards;
  }

  .panel--before {
    border-left: 3px solid var(--accent-edit);
  }

  .panel--after {
    border-left: 3px solid var(--accent);
    animation-delay: 0.45s;
  }

  .panel.replay {
    animation: flash 0.3s ease-out;
  }

  .panel-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin-bottom: 10px;
  }

  .panel--before .panel-label {
    color: var(--accent-edit);
  }

  .panel--after .panel-label {
    color: var(--accent);
  }

  .panel-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    min-height: 4.6em;
  }

  .panel-text--mono {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .connector {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0;
    animation: reveal 0.5s ease-out 0.3s forwards;
  }

  .diff-cycle {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .diff-cycle:hover {
    color: var(--accent);
  }

  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes flash {
    0% {
      opacity: 0.35;
    }
    100% {
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .diff {
      grid-template-columns: 1fr;
    }

    .connector {
      justify-self: start;
      padding-left: 2px;
    }

    .panel-text {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .connector {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".diff-wrap").forEach((wrap) => {
    const examples = JSON.parse(wrap.dataset.examples || "[]") as {
      before: string;
      after: string;
    }[];
    if (examples.length < 2) return;

    let index = 0;
    const beforeEl = wrap.querySelector<HTMLElement>('[data-field="before"]');
    const afterEl = wrap.querySelector<HTMLElement>('[data-field="after"]');
    const panels = wrap.querySelectorAll<HTMLElement>(".panel");
    const button = wrap.querySelector<HTMLButtonElement>(".diff-cycle");

    button?.addEventListener("click", () => {
      index = (index + 1) % examples.length;
      if (beforeEl) beforeEl.textContent = examples[index].before;
      if (afterEl) afterEl.textContent = examples[index].after;
      panels.forEach((panel) => {
        panel.classList.remove("replay");
        void panel.offsetWidth;
        panel.classList.add("replay");
      });
    });
  });
</script>
